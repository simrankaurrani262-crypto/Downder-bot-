# Telegram Bot Configuration (REQUIRED)
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Bot Info
BOT_NAME=Video Downloader Pro
BOT_USERNAME=your_bot_username

# Instagram Configuration (OPTIONAL - for private content)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# RapidAPI Configuration (OPTIONAL - Instagram API fallback)
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=instagram-downloader-download-instagram-videos-stories.p.rapidapi.com

# File Settings
MAX_FILE_SIZE_MB=50
MAX_DOWNLOAD_TIME=300

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DOWNLOADS_PER_MINUTE=5
RATE_LIMIT_DOWNLOADS_PER_HOUR=30

# YouTube Settings
YOUTUBE_DEFAULT_QUALITY=720

# Feature Flags
ENABLE_YOUTUBE=true
ENABLE_INSTAGRAM=true
ENABLE_AUDIO_MODE=true
ENABLE_STATS=true
ENABLE_BROADCAST=true

# Logging
LOG_LEVEL=INFO
